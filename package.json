{
  "name": "chrome-manipulation-detector",
  "version": "0.1.5",
  "private": true,
  "description": "Learn to recognize potential rhetorical patterns in social media posts.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "postinstall": "wxt prepare",
    "dev": "wxt --browser chrome",
    "build": "wxt build --browser chrome",
    "package:chrome": "wxt zip --browser chrome",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "typecheck": "wxt prepare && tsc --noEmit",
    "test": "vitest run",
    "evaluate": "vitest run tests/integration/evaluation.test.ts --disableConsoleIntercept",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/node": "22.20.5",
    "eslint": "10.15.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "4.1.12",
    "wxt": "0.21.5"
  }
}
